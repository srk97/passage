            tensor<int32, [1]> var_1292 = const()[name = tensor<string, []>("op_1292"), val = tensor<int32, [1]>([-1])];
            tensor<bool, []> var_1293 = const()[name = tensor<string, []>("op_1293"), val = tensor<bool, []>(true)];
            tensor<fp16, [1, 1]> var_1295_cast_fp16 = reduce_l2_norm(axes = var_1292, keep_dims = var_1293, x = input_cast_fp16)[name = tensor<string, []>("op_1295_cast_fp16")];
            tensor<fp16, []> var_1296_to_fp16 = const()[name = tensor<string, []>("op_1296_to_fp16"), val = tensor<fp16, []>(0x1p-24)];
            tensor<fp16, [1, 1]> var_1297_cast_fp16 = maximum(x = var_1295_cast_fp16, y = var_1296_to_fp16)[name = tensor<string, []>("op_1297_cast_fp16")];
            tensor<int32, [2]> denom_reps_0 = const()[name = tensor<string, []>("denom_reps_0"), val = tensor<int32, [2]>([1, 512])];
            tensor<fp16, [1, 512]> denom_cast_fp16 = tile(reps = denom_reps_0, x = var_1297_cast_fp16)[name = tensor<string, []>("denom_cast_fp16")];
            tensor<fp16, [1, 512]> embedding = real_div(x = input_cast_fp16, y = denom_cast_fp16)[name = tensor<string, []>("op_1299_cast_fp16")];
        } -> (embedding);
}